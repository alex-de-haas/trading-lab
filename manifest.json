{
  "schemaVersion": "app.0.1",
  "id": "com.haas.trading-lab",
  "name": "Trading Lab",
  "version": "0.2.0",
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "docker",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "web",
      "runtimes": {
        "docker": {
          "type": "docker",
          "artifact": "image",
          "image": {
            "repository": "ghcr.io/alex-de-haas/trading-lab",
            "tag": "0.2.0"
          },
          "environment": {
            "PORT": "3000"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "gracePeriodSeconds": 15,
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3
          }
        },
        "dev": {
          "type": "docker",
          "image": {
            "repository": "node",
            "tag": "24-bookworm-slim"
          },
          "artifact": "source",
          "sourceMount": {
            "path": ".",
            "target": "/workspace",
            "mode": "ro",
            "caches": [
              "node_modules"
            ]
          },
          "workingDirectory": ".",
          "setup": "npm ci --ignore-scripts --no-audit --no-fund",
          "command": "node --import tsx server.ts",
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "gracePeriodSeconds": 90,
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 3
          }
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "http",
      "service": "web",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Trading lab",
        "path": "/"
      }
    ],
    "icon": "chart-no-axes-combined"
  },
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "docker",
        "service": "web",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "service": "web",
        "containerPath": "/app/data",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "description": "Virtual stock trading experiments with replaceable market data providers and trailing reversal strategies.",
  "catalogMetadata": {
    "publisher": {
      "name": "Alex de Haas",
      "url": "https://github.com/alex-de-haas"
    },
    "category": "Utilities",
    "tags": ["paper-trading", "simulation", "backtesting"],
    "icon": "assets/icon.svg",
    "license": "LicenseRef-Proprietary",
    "links": {
      "website": "https://github.com/alex-de-haas/trading-lab",
      "docs": "https://github.com/alex-de-haas/trading-lab/blob/main/README.md"
    },
    "summary": "Virtual trading experiments with synthetic and imported history, trailing reversal rules, fees and transparent accounting.",
    "descriptionFile": "docs/store.md"
  },
  "settings": [
    {
      "key": "TWELVE_DATA_API_KEY",
      "type": "string",
      "secret": true,
      "required": false,
      "label": "Twelve Data API key",
      "description": "Optional. Enables real quotes and available history. Restart the app after changing this key."
    }
  ]
}
